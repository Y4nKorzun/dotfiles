{
  "compaction": {
    "enabled": false
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "enableSkillCommands": true,
  "showHardwareCursor": true,
  "editorPaddingX": 1,
  "terminal": {
    "showTerminalProgress": true
  },
  "hideThinkingBlock": false,
  "markdown": {
    "mermaid": "final"
  },
  "quietStartup": true,
  "defaultProjectTrust": "ask",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "defaultThinkingLevel": "xhigh",
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "always",
  "theme": "slop",
  "packages": [
    "npm:pi-zentui",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:@koltmcbride/pi-loop",
    "npm:@narumitw/pi-goal"
  ],
  "lastChangelogVersion": "0.84.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "outputPad": 1,
  "npmCommand": [
    "npm",
    "--ignore-scripts"
  ]
}
