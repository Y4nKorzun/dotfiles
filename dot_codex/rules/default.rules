prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "mv"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["git", "cherry-pick"], decision="allow")
prefix_rule(pattern=["git", "restore"], decision="allow")
prefix_rule(pattern=["git", "rm", "docs/no-large-curly-block-report.md", "eslint-local-rules/no-large-curly-block.test.ts"], decision="allow")
prefix_rule(pattern=["git", "rm", "-f", "docs/no-large-curly-block-report.md", "eslint-local-rules/no-large-curly-block.test.ts"], decision="allow")
prefix_rule(pattern=["git", "reset", "--soft", "origin/develop"], decision="allow")
prefix_rule(pattern=["git", "switch"], decision="allow")
prefix_rule(pattern=["git", "clean", "-fd", "--", "src/app/payouts"], decision="allow")
prefix_rule(pattern=["npm", "install"], decision="allow")
prefix_rule(pattern=["npm", "run", "dev"], decision="allow")
prefix_rule(pattern=["curl"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["gh", "api"], decision="allow")
prefix_rule(pattern=["gh", "pr", "create"], decision="allow")
prefix_rule(pattern=["git", "stash", "push"], decision="allow")
