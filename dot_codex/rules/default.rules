prefix_rule(pattern=["gh", "pr", "create"], decision="allow")
prefix_rule(pattern=["git", "stash", "push"], decision="allow")
prefix_rule(pattern=["go", "test"], decision="allow")
prefix_rule(pattern=["node", "--import", "tsx", "--test"], decision="allow")
prefix_rule(pattern=["gofmt", "-w", "internal/tui/add_entry.go", "internal/tui/add_entry_test.go"], decision="allow")
prefix_rule(pattern=["go", "run"], decision="allow")
prefix_rule(pattern=["gofmt", "-w", "internal/tui/add_entry_test.go"], decision="allow")
prefix_rule(pattern=["gofmt", "-w", "cmd/vpntui/main.go", "cmd/vpntui/main_test.go"], decision="allow")
prefix_rule(pattern=["gofmt", "-w", "internal/tui/messages.go", "internal/tui/app.go", "internal/tui/browser.go", "internal/tui/browser_test.go", "internal/tui/app_test.go", "internal/tui/messages_test.go"], decision="allow")
prefix_rule(pattern=["gofmt", "-w", "internal/tui/browser.go", "internal/tui/browser_test.go", "internal/tui/e2e_test.go"], decision="allow")
prefix_rule(pattern=["gofmt", "-w", "internal/tui/status.go", "internal/tui/status_test.go", "cmd/vpntui/main.go", "cmd/vpntui/main_test.go"], decision="allow")
prefix_rule(pattern=["go", "vet", "./..."], decision="allow")
prefix_rule(pattern=["git", "diff", "--check"], decision="allow")
prefix_rule(pattern=["gofmt", "-w", "internal/tui/import_google.go", "internal/tui/import_google_test.go"], decision="allow")
prefix_rule(pattern=["sed", "-n", "1,200p"], decision="allow")
prefix_rule(pattern=["pnpm", "run", "test:file"], decision="allow")
prefix_rule(pattern=["npm", "run", "pack:check"], decision="allow")
